# Copy this file to .env and fill the values.
# Do NOT commit the real .env - it contains secrets.

# --- Database -------------------------------------------------------------
# Neon / PostgreSQL connection string. If omitted, a local SQLite file is used.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require"

# --- App ------------------------------------------------------------------
# Public base URL of the app (used in notification links).
BASE_URL="http://127.0.0.1:8000"
# Arabic hospital name shown in alerts (display only).
HOSPITAL_NAME="مستشفى الأمير محمد بن ناصر - جازان"
# Random long string for session signing. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY="change-me"

# --- Email notifications (optional) --------------------------------------
# Gmail app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=

# --- Telegram notifications (optional) -----------------------------------
# Create a bot with @BotFather, then read @userinfobot for your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Cloud API notifications (optional, Meta) -------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
